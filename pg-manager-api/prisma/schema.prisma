generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ─── Enums ──────────────────────────────────────────────────────────

enum Plan {
  free
  basic
  pro
}

enum RoomType {
  single
  double
  triple
}

enum BedStatus {
  vacant
  occupied
  reserved
}

enum TenantStatus {
  active
  checked_out
  suspended
}

enum DocType {
  aadhaar
  pan
  passport
  driving_licence
  other
}

enum DepositStatus {
  pending
  paid
  refunded
}

enum LeaseStatus {
  active
  terminated
  expired
}

enum InvoiceStatus {
  draft
  sent
  paid
  partially_paid
  overdue
  waived
}

enum PaymentMethod {
  upi
  card
  cash
  bank_transfer
  other
}

enum PaymentStatus {
  pending
  success
  failed
  refunded
}

enum InvoiceItemType {
  rent
  late_fee
  utility
  maintenance
  other
}

enum ComplaintCategory {
  plumbing
  electrical
  wifi
  cleaning
  furniture
  security
  other
}

enum ComplaintStatus {
  open
  in_progress
  resolved
  closed
}

enum UpdatedBy {
  owner
  tenant
}

enum NotificationType {
  rent_due
  rent_reminder
  payment_success
  overdue_notice
  late_fee_applied
  complaint_update
  notice
  otp
}

enum NotificationChannel {
  push
  whatsapp
  sms
}

enum NotificationStatus {
  sent
  delivered
  failed
}

// ─── 1. Owners ──────────────────────────────────────────────────────

model Owner {
  id             String    @id @default(uuid()) @db.Uuid
  name           String    @db.VarChar(255)
  phone          String    @unique @db.VarChar(20)
  email          String?   @db.VarChar(255)
  plan           Plan      @default(free)
  expoPushToken  String?   @map("expo_push_token") @db.VarChar(100)
  isActive       Boolean   @default(true) @map("is_active")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")
  deletedAt      DateTime? @map("deleted_at")

  properties   Property[]
  tenants      Tenant[]
  notices      Notice[]
  bookings     Booking[]
  leads        Lead[]
  duesPackages DuesPackage[]

  @@map("owners")
}

// ─── 2. Properties ──────────────────────────────────────────────────

model Property {
  id                      String    @id @default(uuid()) @db.Uuid
  ownerId                 String?   @map("owner_id") @db.Uuid
  sourcePropertyId        String?   @unique @map("source_property_id") @db.VarChar(100)
  sourcePgId              String?   @map("source_pg_id") @db.VarChar(100)
  sourceEazypgId          String?   @map("source_eazypg_id") @db.VarChar(100)
  sourcePgNumber          Int?      @map("source_pg_number")
  name                    String    @db.VarChar(255)
  address                 String
  city                    String    @db.VarChar(100)
  state                   String?   @db.VarChar(100)
  pincode                 String?   @db.VarChar(20)
  availableFor            String?   @map("available_for") @db.VarChar(100)
  about                   String?   @db.Text
  commonAmenitiesSummary  String?   @map("common_amenities_summary") @db.Text
  serviceAmenitiesSummary String?   @map("service_amenities_summary") @db.Text
  foodAmenitiesSummary    String?   @map("food_amenities_summary") @db.Text
  imageUrls               Json?     @default("[]") @map("image_urls") @db.JsonB
  latitude                Float?    @db.DoublePrecision
  longitude               Float?    @db.DoublePrecision
  totalBeds               Int       @default(0) @map("total_beds")
  amenities               Json?     @default("[]") @db.JsonB
  isActive                Boolean   @default(true) @map("is_active")
  createdAt               DateTime  @default(now()) @map("created_at")
  updatedAt               DateTime  @updatedAt @map("updated_at")
  deletedAt               DateTime? @map("deleted_at")

  owner        Owner?         @relation(fields: [ownerId], references: [id])
  floors       Floor[]
  rooms        Room[]
  leases       Lease[]
  invoices     Invoice[]
  complaints   Complaint[]
  notices      Notice[]
  expenses     Expense[]
  bookings     Booking[]
  leads        Lead[]
  duesPackages DuesPackage[]

  @@index([ownerId])
  @@map("properties")
}

// ─── 3. Floors ──────────────────────────────────────────────────────

model Floor {
  id         String   @id @default(uuid()) @db.Uuid
  propertyId String   @map("property_id") @db.Uuid
  label      String   @db.VarChar(100)
  createdAt  DateTime @default(now()) @map("created_at")

  property Property @relation(fields: [propertyId], references: [id])
  rooms    Room[]

  @@index([propertyId])
  @@map("floors")
}

// ─── 4. Rooms ───────────────────────────────────────────────────────

model Room {
  id         String   @id @default(uuid()) @db.Uuid
  propertyId String   @map("property_id") @db.Uuid
  floorId    String?  @map("floor_id") @db.Uuid
  roomNumber String   @map("room_number") @db.VarChar(20)
  roomType   RoomType @map("room_type")
  rentAmount Decimal  @map("rent_amount") @db.Decimal(10, 2)
  isActive   Boolean  @default(true) @map("is_active")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  property Property @relation(fields: [propertyId], references: [id])
  floor    Floor?   @relation(fields: [floorId], references: [id])
  beds     Bed[]

  @@index([propertyId])
  @@map("rooms")
}

// ─── 5. Beds ────────────────────────────────────────────────────────

model Bed {
  id        String    @id @default(uuid()) @db.Uuid
  roomId    String    @map("room_id") @db.Uuid
  label     String    @db.VarChar(50)
  status    BedStatus @default(vacant)
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  room     Room      @relation(fields: [roomId], references: [id])
  leases   Lease[]
  bookings Booking[]

  @@index([status])
  @@index([roomId])
  @@map("beds")
}

// ─── 6. Tenants ─────────────────────────────────────────────────────

model Tenant {
  id                    String       @id @default(uuid()) @db.Uuid
  ownerId               String       @map("owner_id") @db.Uuid
  name                  String       @db.VarChar(255)
  phone                 String       @db.VarChar(20)
  email                 String?      @db.VarChar(255)
  emergencyContactName  String?      @map("emergency_contact_name") @db.VarChar(255)
  emergencyContactPhone String?      @map("emergency_contact_phone") @db.VarChar(20)
  profilePhotoUrl       String?      @map("profile_photo_url")
  expoPushToken         String?      @map("expo_push_token") @db.VarChar(100)
  status                TenantStatus @default(active)
  createdAt             DateTime     @default(now()) @map("created_at")
  updatedAt             DateTime     @updatedAt @map("updated_at")
  deletedAt             DateTime?    @map("deleted_at")

  owner         Owner            @relation(fields: [ownerId], references: [id])
  documents     TenantDocument[]
  leases        Lease[]
  invoices      Invoice[]
  payments      Payment[]
  complaints    Complaint[]
  notifications Notification[]

  @@unique([ownerId, phone])
  @@map("tenants")
}

model Prospect {
  id        String    @id @default(uuid()) @db.Uuid
  name      String    @db.VarChar(255)
  phone     String    @unique @db.VarChar(20)
  email     String?   @db.VarChar(255)
  isActive  Boolean   @default(true) @map("is_active")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  @@map("prospects")
}

// ─── 7. Tenant Documents ────────────────────────────────────────────

model TenantDocument {
  id         String    @id @default(uuid()) @db.Uuid
  tenantId   String    @map("tenant_id") @db.Uuid
  docType    DocType   @map("doc_type")
  fileUrl    String    @map("file_url")
  verified   Boolean   @default(false)
  verifiedAt DateTime? @map("verified_at")
  createdAt  DateTime  @default(now()) @map("created_at")

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@index([tenantId])
  @@map("tenant_documents")
}

// ─── 8. Leases ──────────────────────────────────────────────────────

model Lease {
  id              String        @id @default(uuid()) @db.Uuid
  tenantId        String        @map("tenant_id") @db.Uuid
  bedId           String        @map("bed_id") @db.Uuid
  propertyId      String        @map("property_id") @db.Uuid
  duesPackageId   String?       @map("dues_package_id") @db.Uuid
  rentAmount      Decimal       @map("rent_amount") @db.Decimal(10, 2)
  securityDeposit Decimal       @default(0) @map("security_deposit") @db.Decimal(10, 2)
  depositStatus   DepositStatus @default(pending) @map("deposit_status")
  billingDay      Int           @map("billing_day")
  moveInDate      DateTime      @map("move_in_date") @db.Date
  moveOutDate     DateTime?     @map("move_out_date") @db.Date
  status          LeaseStatus   @default(active)
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @updatedAt @map("updated_at")

  tenant        Tenant          @relation(fields: [tenantId], references: [id])
  bed           Bed             @relation(fields: [bedId], references: [id])
  property      Property        @relation(fields: [propertyId], references: [id])
  duesPackage   DuesPackage?    @relation(fields: [duesPackageId], references: [id])
  invoices      Invoice[]
  lateFeePolicy LateFeePolicy?

  @@index([status, billingDay])
  @@index([tenantId])
  @@index([propertyId])
  @@index([bedId])
  @@map("leases")
}

// ─── 9. Invoices ────────────────────────────────────────────────────

model Invoice {
  id             String        @id @default(uuid()) @db.Uuid
  leaseId        String        @map("lease_id") @db.Uuid
  tenantId       String        @map("tenant_id") @db.Uuid
  propertyId     String        @map("property_id") @db.Uuid
  invoiceNumber  String        @map("invoice_number") @db.VarChar(50)
  periodStart    DateTime      @map("period_start") @db.Date
  periodEnd      DateTime      @map("period_end") @db.Date
  dueDate        DateTime      @map("due_date") @db.Date
  subtotal       Decimal       @db.Decimal(10, 2)
  total          Decimal       @db.Decimal(10, 2)
  status         InvoiceStatus @default(draft)
  idempotencyKey String?       @unique @map("idempotency_key") @db.VarChar(100)
  createdAt      DateTime      @default(now()) @map("created_at")
  updatedAt      DateTime      @updatedAt @map("updated_at")

  lease    Lease         @relation(fields: [leaseId], references: [id])
  tenant   Tenant        @relation(fields: [tenantId], references: [id])
  property Property      @relation(fields: [propertyId], references: [id])
  items    InvoiceItem[]
  payments Payment[]

  @@index([tenantId, status])
  @@index([propertyId])
  @@index([leaseId])
  @@map("invoices")
}

// ─── 10. Invoice Items ──────────────────────────────────────────────

model InvoiceItem {
  id          String          @id @default(uuid()) @db.Uuid
  invoiceId   String          @map("invoice_id") @db.Uuid
  type        InvoiceItemType @default(other)
  description String          @db.VarChar(255)
  amount      Decimal         @db.Decimal(10, 2)
  createdAt   DateTime        @default(now()) @map("created_at")

  invoice Invoice @relation(fields: [invoiceId], references: [id])

  @@index([invoiceId])
  @@map("invoice_items")
}

// ─── 11. Payments ───────────────────────────────────────────────────

model Payment {
  id                 String        @id @default(uuid()) @db.Uuid
  invoiceId          String        @map("invoice_id") @db.Uuid
  tenantId           String        @map("tenant_id") @db.Uuid
  amount             Decimal       @db.Decimal(10, 2)
  method             PaymentMethod
  status             PaymentStatus @default(pending)
  referenceNo        String?       @map("reference_no") @db.VarChar(100)
  collectedBy        String?       @map("collected_by") @db.VarChar(255)
  idempotencyKey     String?       @unique @map("idempotency_key") @db.VarChar(100)
  razorpayPaymentId  String?       @map("razorpay_payment_id") @db.VarChar(100)
  razorpayOrderId    String?       @map("razorpay_order_id") @db.VarChar(100)
  paidAt             DateTime?     @map("paid_at")
  createdAt          DateTime      @default(now()) @map("created_at")

  invoice Invoice  @relation(fields: [invoiceId], references: [id])
  tenant  Tenant   @relation(fields: [tenantId], references: [id])
  receipt Receipt?

  @@index([razorpayPaymentId])
  @@index([invoiceId])
  @@index([tenantId])
  @@map("payments")
}

// ─── 12. Complaints ─────────────────────────────────────────────────

model Complaint {
  id          String            @id @default(uuid()) @db.Uuid
  tenantId    String            @map("tenant_id") @db.Uuid
  propertyId  String            @map("property_id") @db.Uuid
  category    ComplaintCategory
  title       String            @db.VarChar(255)
  description String
  photoUrls   Json?             @default("[]") @map("photo_urls") @db.JsonB
  status      ComplaintStatus   @default(open)
  assignedTo  String?           @map("assigned_to") @db.VarChar(255)
  resolvedAt  DateTime?         @map("resolved_at")
  rating      Int?
  createdAt   DateTime          @default(now()) @map("created_at")
  updatedAt   DateTime          @updatedAt @map("updated_at")

  tenant   Tenant            @relation(fields: [tenantId], references: [id])
  property Property          @relation(fields: [propertyId], references: [id])
  updates  ComplaintUpdate[]

  @@index([propertyId, status])
  @@map("complaints")
}

// ─── 13. Complaint Updates ──────────────────────────────────────────

model ComplaintUpdate {
  id          String          @id @default(uuid()) @db.Uuid
  complaintId String          @map("complaint_id") @db.Uuid
  updatedBy   UpdatedBy       @map("updated_by")
  message     String
  status      ComplaintStatus
  createdAt   DateTime        @default(now()) @map("created_at")

  complaint Complaint @relation(fields: [complaintId], references: [id])

  @@index([complaintId])
  @@map("complaint_updates")
}

// ─── 14. Notices ────────────────────────────────────────────────────

model Notice {
  id         String   @id @default(uuid()) @db.Uuid
  propertyId String?  @map("property_id") @db.Uuid
  title      String   @db.VarChar(255)
  body       String
  createdBy  String   @map("created_by") @db.Uuid
  createdAt  DateTime @default(now()) @map("created_at")

  property Property? @relation(fields: [propertyId], references: [id])
  owner    Owner     @relation(fields: [createdBy], references: [id])

  @@map("notices")
}

// ─── 15. Notifications ──────────────────────────────────────────────

model Notification {
  id        String              @id @default(uuid()) @db.Uuid
  tenantId  String              @map("tenant_id") @db.Uuid
  type      NotificationType
  channel   NotificationChannel
  message   String
  status    NotificationStatus  @default(sent)
  sentAt    DateTime?           @map("sent_at")
  createdAt DateTime            @default(now()) @map("created_at")

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@index([tenantId])
  @@map("notifications")
}

// ─── 16. Late Fee Policies ──────────────────────────────────────────

model LateFeePolicy {
  id             String   @id @default(uuid()) @db.Uuid
  leaseId        String   @unique @map("lease_id") @db.Uuid
  graceDays      Int      @default(5) @map("grace_days")
  feeType        String   @default("fixed") @db.VarChar(20) // "fixed" or "percentage"
  feeAmount      Decimal  @db.Decimal(10, 2)
  maxFee         Decimal? @map("max_fee") @db.Decimal(10, 2)
  isActive       Boolean  @default(true) @map("is_active")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  lease Lease @relation(fields: [leaseId], references: [id])

  @@map("late_fee_policies")
}

// ─── 17. Receipts ──────────────────────────────────────────────────

model Receipt {
  id            String   @id @default(uuid()) @db.Uuid
  paymentId     String   @unique @map("payment_id") @db.Uuid
  receiptNumber String   @unique @map("receipt_number") @db.VarChar(50)
  amount        Decimal  @db.Decimal(10, 2)
  issuedAt      DateTime @default(now()) @map("issued_at")
  createdAt     DateTime @default(now()) @map("created_at")

  payment Payment @relation(fields: [paymentId], references: [id])

  @@map("receipts")
}

// ─── 18. Expenses ────────────────────────────────────────────────────

model Expense {
  id          String   @id @default(uuid()) @db.Uuid
  propertyId  String   @map("property_id") @db.Uuid
  category    String   @db.VarChar(100)
  amount      Decimal  @db.Decimal(10, 2)
  description String   @db.Text
  date        DateTime @db.Date
  createdAt   DateTime @default(now()) @map("created_at")

  property Property @relation(fields: [propertyId], references: [id])

  @@index([propertyId, date])
  @@map("expenses")
}

// ─── 19. Bookings ────────────────────────────────────────────────────

enum BookingStatus {
  pending
  confirmed
  cancelled
  converted
}

model Booking {
  id              String        @id @default(uuid()) @db.Uuid
  ownerId         String        @map("owner_id") @db.Uuid
  propertyId      String        @map("property_id") @db.Uuid
  bedId           String?       @map("bed_id") @db.Uuid
  name            String        @db.VarChar(255)
  phone           String        @db.VarChar(20)
  email           String?       @db.VarChar(255)
  expectedCheckIn DateTime      @map("expected_check_in") @db.Date
  rentAmount      Decimal       @map("rent_amount") @db.Decimal(10, 2)
  advanceAmount   Decimal       @default(0) @map("advance_amount") @db.Decimal(10, 2)
  advancePaid     Boolean       @default(false) @map("advance_paid")
  status          BookingStatus @default(pending)
  notes           String?       @db.Text
  convertedTenantId String?     @map("converted_tenant_id") @db.Uuid
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @updatedAt @map("updated_at")

  owner    Owner    @relation(fields: [ownerId], references: [id])
  property Property @relation(fields: [propertyId], references: [id])
  bed      Bed?     @relation(fields: [bedId], references: [id])

  @@index([ownerId, status])
  @@index([propertyId])
  @@map("bookings")
}

// ─── 20. Leads ───────────────────────────────────────────────────────

enum LeadSource {
  walk_in
  online
  referral
  social_media
  other
}

enum LeadStatus {
  new_lead
  contacted
  interested
  visit_scheduled
  visit_done
  converted
  lost
}

model Lead {
  id            String     @id @default(uuid()) @db.Uuid
  ownerId       String     @map("owner_id") @db.Uuid
  propertyId    String?    @map("property_id") @db.Uuid
  name          String     @db.VarChar(255)
  phone         String     @db.VarChar(20)
  email         String?    @db.VarChar(255)
  source        LeadSource @default(other)
  status        LeadStatus @default(new_lead)
  budget        Decimal?   @db.Decimal(10, 2)
  preferredRoomType String? @map("preferred_room_type") @db.VarChar(50)
  followUpDate  DateTime?  @map("follow_up_date") @db.Date
  notes         String?    @db.Text
  convertedBookingId String? @map("converted_booking_id") @db.Uuid
  createdAt     DateTime   @default(now()) @map("created_at")
  updatedAt     DateTime   @updatedAt @map("updated_at")

  owner    Owner     @relation(fields: [ownerId], references: [id])
  property Property? @relation(fields: [propertyId], references: [id])

  @@index([ownerId, status])
  @@index([propertyId])
  @@map("leads")
}

// ─── 21. Dues Packages ──────────────────────────────────────────────

enum DuesFrequency {
  monthly
  quarterly
  half_yearly
  yearly
}

model DuesPackage {
  id            String        @id @default(uuid()) @db.Uuid
  ownerId       String        @map("owner_id") @db.Uuid
  propertyId    String?       @map("property_id") @db.Uuid
  name          String        @db.VarChar(255)
  frequency     DuesFrequency @default(monthly)
  totalAmount   Decimal       @map("total_amount") @db.Decimal(10, 2)
  autoGenerate  Boolean       @default(true) @map("auto_generate")
  isActive      Boolean       @default(true) @map("is_active")
  createdAt     DateTime      @default(now()) @map("created_at")
  updatedAt     DateTime      @updatedAt @map("updated_at")

  owner    Owner              @relation(fields: [ownerId], references: [id])
  property Property?          @relation(fields: [propertyId], references: [id])
  items    DuesPackageItem[]
  leases   Lease[]

  @@index([ownerId])
  @@map("dues_packages")
}

model DuesPackageItem {
  id            String          @id @default(uuid()) @db.Uuid
  packageId     String          @map("package_id") @db.Uuid
  type          InvoiceItemType @default(other)
  description   String          @db.VarChar(255)
  amount        Decimal         @db.Decimal(10, 2)
  createdAt     DateTime        @default(now()) @map("created_at")

  package DuesPackage @relation(fields: [packageId], references: [id], onDelete: Cascade)

  @@index([packageId])
  @@map("dues_package_items")
}
